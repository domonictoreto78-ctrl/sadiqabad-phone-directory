# Supabase Configuration (Frontend & Serverless Functions)
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Google Maps API Key (Optional: Gracefully falls back to interactive OpenStreetMap & Google Maps Embed if empty)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Netlify AI Gateway (No API key needed!):
# When deployed on Netlify, the OpenAI SDK connects directly to Netlify AI Gateway without any manual secret.
# Note: First production deploy to Netlify is required before the Netlify AI Gateway is active.
# In local development or preview without Netlify, the app gracefully falls back to the built-in local synonym dictionary.
