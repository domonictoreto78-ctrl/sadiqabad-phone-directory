# ==============================================================================
# Sadiqabad City Phone Directory - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE ENVIRONMENT VARIABLES (Exposed to browser via envPrefix)
# ------------------------------------------------------------------------------

# Supabase Project URL (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anonymous Public Key (Safe for browser client, governed by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Google Maps JavaScript / Embed Key (Optional: falls back to open embed if omitted)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Router Mode: "hash" (default for preview & iframe environments) or "history" (clean URLs on Netlify production)
VITE_ROUTER_MODE="hash"


# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES (Used strictly by Netlify Functions)
# WARNING: NEVER prefix these with NEXT_PUBLIC_ or VITE_ to prevent browser leaks.
# ------------------------------------------------------------------------------

# Netlify AI Gateway (Automatic on Netlify!):
# In production on Netlify, the Netlify AI Gateway automatically injects OPENAI_BASE_URL
# and authentication tokens for Node 20 functions. No manual OpenAI key is needed!
# (Optional fallback for local dev outside of Netlify CLI):
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# Supabase Service Role Key (SERVER-ONLY, optional):
# Only needed if you run server administrative operations bypassing RLS.
# Standard public submissions and review creations use the anon key with database RLS policies.
SUPABASE_SERVICE_ROLE_KEY=""
